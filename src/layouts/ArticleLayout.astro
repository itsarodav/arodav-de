---
import Layout from './Layout.astro';
import TopBar from '@/components/TopBar.astro';
import MobileMenu from '@/components/MobileMenu.astro';
import Aside from '@/components/Aside.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BackButton from '@/components/BackButton.astro';
import Footer from '@/components/Footer.astro';
import { type Lang, getWritingPath, useTranslations } from '@/i18n';

interface Props {
  title: string;
  description: string;
  date: Date;
  lang: Lang;
}

const { title, description, date, lang } = Astro.props;

const formattedDate = date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const t = useTranslations(lang);
const writingPath = getWritingPath(lang);
const writingLabel = lang === 'es' ? 'Escritos' : 'Writing';
const currentPath = Astro.url.pathname;
---

<Layout title={`${title} -Andrea Robles Dávila`} description={description} lang={lang}>
  <TopBar lang={lang} />
  <MobileMenu lang={lang} currentPath={currentPath} />

  <main class="page-article">
    <Breadcrumb label={title} lang={lang} tag="span" parents={[{ label: writingLabel, href: writingPath }]} />
    <BackButton lang={lang} />
    <header class="article-header">
      <h1 class="article-header__title">{title}</h1>
      <time class="article-header__date" datetime={date.toISOString()}>
        {formattedDate}
      </time>
    </header>
    <Aside contentSelector=".article-content" lang={lang} />
    <article class="article-content">
      <slot />
      <Footer lang={lang} />
    </article>
  </main>
</Layout>
