---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const logoSvg = await import('/src/icons/arodav-profilee.svg?raw');
---

<section class="hero">
  <div class="hero__logo" aria-hidden="true">
    <Fragment set:html={logoSvg.default} />
  </div>
  <h1 class="hero__name">{t('hero.name')}</h1>
  <p class="hero__bio">
    <Fragment set:html={t('hero.bio_1a')} />
    {' '}
    <a class="hero__link" href="https://www.odilo.us/" target="_blank" rel="noopener noreferrer">
      ODILO
      <Icon name="arrow-out" size={14} color="currentColor" role="decorative" />
    </a>
    <Fragment set:html={t('hero.bio_1b')} />
    {' '}
    <a class="hero__link" href="https://github.com/itsarodav" target="_blank" rel="noopener noreferrer">
      arodav
      <Icon name="arrow-out" size={14} color="currentColor" role="decorative" />
    </a>
    <Fragment set:html={t('hero.bio_1c')} />
  </p>
  <p class="hero__bio">{t('hero.bio_2')}</p>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .hero {
    margin-bottom: $space-14;

    @include respond-to(md) {
      margin-bottom: $space-16;
    }

    &__logo {
      margin-bottom: $space-6;

      :global(svg) {
        width: 48px;
        height: 48px;
      }
    }

    &__name {
      font-size: $text-base;
      font-weight: $font-semibold;
      line-height: $line-snug;
      letter-spacing: $tracking-normal;
      color: var(--color-text-primary);
      margin-bottom: $space-4;
    }

    &__bio {
      font-size: $text-base;
      font-weight: $font-medium;
      line-height: $line-normal;
      letter-spacing: $tracking-normal;
      color: var(--color-text-secondary);
      margin-bottom: $space-4;

      &:last-child {
        margin-bottom: 0;
      }

    }

    &__link {
      display: inline-flex;
      align-items: center;
      gap: $space-1;
      color: var(--color-link);
      text-decoration: none;
      transition: color 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);

      :global(svg) {
        display: inline-block;
        flex-shrink: 0;
      }

      @media (hover: hover) {
        &:hover {
          color: var(--color-text-primary);
        }
      }
    }
  }

</style>

<script>
  import { gsap } from 'gsap';

  function initLogoAnimation() {
    const logo = document.querySelector('.hero__logo');
    if (!logo) return;

    const svg = logo.querySelector('svg');
    if (!svg) return;

    const isotipo = svg.querySelector('.isotipo');
    const pupilLeft = svg.querySelector('.pupil-left');
    const pupilRight = svg.querySelector('.pupil-right');

    if (!isotipo) return;

    // --- Default pupil position (less white space, matching favicon) ---
    if (pupilLeft && pupilRight) {
      const defaultX = 0;
      const defaultY = 0;
      gsap.set(pupilRight, { x: defaultX, y: defaultY, scale: 1.22, svgOrigin: '36 27' });
      gsap.set(pupilLeft, { x: defaultX, y: defaultY, scale: 1.22, svgOrigin: '22.5 30' });

      const eyes = [
        { el: pupilRight, radius: 1.2 },
        { el: pupilLeft, radius: 1.2 },
      ];

      const isMobile = window.matchMedia('(pointer: coarse)').matches;

      if (isMobile) {
        // Mobile: smooth up and back
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 2.5 });
        eyes.forEach(({ el, radius }) => {
          tl.to(el, {
            x: defaultX,
            y: defaultY - radius * 0.6,
            duration: 0.6,
            ease: 'power2.inOut',
          }, 0);
        });
        eyes.forEach(({ el }) => {
          tl.to(el, {
            x: defaultX,
            y: defaultY,
            duration: 0.6,
            ease: 'power2.inOut',
          }, 0.8);
        });
      } else {
        // Desktop: follow cursor
        document.addEventListener('mousemove', (e) => {
          const rect = svg.getBoundingClientRect();
          const svgCenterX = rect.left + rect.width / 2;
          const svgCenterY = rect.top + rect.height / 2;

          const dx = e.clientX - svgCenterX;
          const dy = e.clientY - svgCenterY;
          const angle = Math.atan2(dy, dx);

          eyes.forEach(({ el, radius }) => {
            gsap.to(el, {
              x: defaultX + Math.cos(angle) * radius,
              y: defaultY + Math.sin(angle) * radius,
              duration: 0.3,
              ease: 'power2.out',
            });
          });
        });
      }
    }

    // --- Blink every 4 seconds ---
    if (pupilLeft && pupilRight) {
      function blink() {
        gsap.timeline()
          .to([pupilLeft, pupilRight], {
            scaleY: 0.05,
            duration: 0.07,
            ease: 'power2.in',
          })
          .to([pupilLeft, pupilRight], {
            scaleY: 1,
            duration: 0.1,
            ease: 'power2.out',
          });
      }

      setTimeout(() => {
        blink();
        setInterval(blink, 3000);
      }, 2500);
    }

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLogoAnimation);
  } else {
    initLogoAnimation();
  }
</script>
