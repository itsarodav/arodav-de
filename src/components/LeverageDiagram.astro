---
import { useTranslations } from '@/i18n';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<figure class="leverage" role="img" aria-label={t('case.linkims.leverage.title_sr')}>
  <div class="leverage__row">
    <span class="leverage__label">{t('case.linkims.leverage.shared')}</span>
    <div class="leverage__track">
      <div class="leverage__bar leverage__bar--shared" data-target="86" style="width: 0%"></div>
    </div>
    <div class="leverage__meta">
      <span class="leverage__pct leverage__pct--shared">{t('case.linkims.leverage.shared_pct')}</span>
      <span class="leverage__detail">{t('case.linkims.leverage.shared_detail')}</span>
    </div>
  </div>

  <div class="leverage__row">
    <span class="leverage__label">{t('case.linkims.leverage.artist')}</span>
    <div class="leverage__track">
      <div class="leverage__bar leverage__bar--artist" data-target="14" style="width: 0%"></div>
    </div>
    <div class="leverage__meta">
      <span class="leverage__pct leverage__pct--artist">{t('case.linkims.leverage.artist_pct')}</span>
      <span class="leverage__detail">{t('case.linkims.leverage.artist_detail')}</span>
    </div>
  </div>
</figure>

<script>
  const figure = document.querySelector('.leverage');
  if (figure) {
    const bars = figure.querySelectorAll<HTMLElement>('.leverage__bar');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bars.forEach((bar) => {
              const target = bar.dataset.target;
              bar.style.width = `${target}%`;
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.4 }
    );
    observer.observe(figure);
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .leverage {
    margin: $space-12 0;
    padding: $space-8 $space-4;
    display: flex;
    flex-direction: column;
    gap: $space-12;
  }

  .leverage__row {
    display: flex;
    flex-direction: column;
    gap: $space-3;
  }

  .leverage__label {
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: $text-sm;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: $line-normal;
  }

  .leverage__track {
    width: 100%;
    height: 14px;
    background-color: var(--color-bg-secondary);
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .leverage__bar {
    height: 100%;
    border-radius: 5px;
    transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .leverage__bar--shared {
    background-color: var(--color-link);
  }

  .leverage__bar--artist {
    background-color: var(--color-accent);
  }

  .leverage__meta {
    display: flex;
    align-items: baseline;
    gap: $space-2;
  }

  .leverage__pct {
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: $text-sm;
    font-weight: 700;
    line-height: $line-normal;

    &--shared {
      color: var(--color-link);
    }

    &--artist {
      color: var(--color-accent);
    }
  }

  .leverage__detail {
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: $text-xs;
    font-weight: 400;
    color: var(--color-text-tertiary);
    line-height: $line-normal;
  }
</style>
