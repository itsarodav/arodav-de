---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  contentSelector: string;
  lang: Lang;
}

const { contentSelector, lang } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === 'es' ? '/es' : '/';
---

<nav class="aside" aria-label="Table of contents" data-content-selector={contentSelector}>
  <a class="aside__back" href={homePath}>
    <Icon name="arrow-left" size={14} color="currentColor" role="decorative" />
    <span>{t('nav.back_home')}</span>
  </a>
  <ul class="aside__list"></ul>
</nav>

<script>
  const aside = document.querySelector('.aside') as HTMLElement | null;
  if (aside) {
    const contentSelector = aside.dataset.contentSelector;
    if (contentSelector) {
      const contentArea = document.querySelector(contentSelector);
      const list = aside.querySelector('.aside__list');

      if (contentArea && list) {
        const headings = contentArea.querySelectorAll('h2');

        if (headings.length === 0) {
          aside.style.display = 'none';
        } else {
          // Generate IDs for headings without one
          headings.forEach((h2, index) => {
            if (!h2.id) {
              const slug = h2.textContent
                ?.trim()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
              h2.id = slug || `section-${index}`;
            }
          });

          // Build the link list
          headings.forEach((h2) => {
            const li = document.createElement('li');
            li.className = 'aside__item';
            const a = document.createElement('a');
            a.className = 'aside__link';
            a.href = `#${h2.id}`;
            a.textContent = h2.textContent?.trim() || '';
            li.appendChild(a);
            list.appendChild(li);
          });

          // Position aside at a fixed left offset
          const ASIDE_WIDTH = 176;
          const ASIDE_LEFT = 48;
          const MIN_GAP = 16;

          function positionAside() {
            const content = document.querySelector(contentSelector!);
            if (!content) return;

            const contentLeft = content.getBoundingClientRect().left;
            const asideRight = ASIDE_LEFT + ASIDE_WIDTH;

            if (contentLeft - asideRight < MIN_GAP) {
              aside!.style.display = 'none';
            } else {
              aside!.style.display = '';
              aside!.style.left = `${ASIDE_LEFT}px`;
            }
          }

          window.addEventListener('resize', positionAside, { passive: true });
          positionAside();

          // Track active heading based on scroll position
          const links = list.querySelectorAll('.aside__link');
          let currentActiveId: string | null = null;

          function setActive(id: string | null) {
            if (id === currentActiveId) return;
            currentActiveId = id;

            if (id) {
              list!.classList.add('aside__list--has-active');
            } else {
              list!.classList.remove('aside__list--has-active');
            }

            links.forEach((link) => {
              const href = link.getAttribute('href');
              if (href === `#${id}`) {
                link.classList.add('aside__link--active');
              } else {
                link.classList.remove('aside__link--active');
              }
            });
          }

          // IntersectionObserver for active state
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  setActive(entry.target.id);
                }
              });
            },
            {
              rootMargin: '-80px 0px -60% 0px',
              threshold: 0,
            }
          );

          headings.forEach((h2) => observer.observe(h2));

          // Smooth scroll on click
          links.forEach((link) => {
            link.addEventListener('click', (e) => {
              e.preventDefault();
              const href = link.getAttribute('href');
              if (!href) return;
              const target = document.getElementById(href.slice(1));
              if (target) {
                const y = target.getBoundingClientRect().top + window.scrollY - 80;
                window.scrollTo({ top: y, behavior: 'smooth' });
              }
            });
          });
        }
      }
    }
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .aside {
    display: none;

    @include respond-to(lg) {
      display: block;
      position: fixed;
      top: $space-20;
      width: 11rem;
    }

    &__back {
      display: inline-flex;
      align-items: center;
      gap: $space-2;
      font-size: $text-sm;
      font-weight: $font-medium;
      letter-spacing: $tracking-wide;
      color: var(--color-text-tertiary);
      text-decoration: none;
      margin-bottom: $space-8;
      transition: color 0.2s ease;

      &:hover {
        color: var(--color-text-primary);
      }
    }

    :global(.aside__list) {
      display: flex;
      flex-direction: column;
      gap: $space-1;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    :global(.aside__link) {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      font-size: $text-sm;
      font-weight: $font-regular;
      letter-spacing: $tracking-wide;
      line-height: $line-normal;
      color: var(--color-text-tertiary);
      padding: $space-1 0;
      transition: color 0.2s ease, opacity 0.2s ease;
      text-decoration: none;

      &:hover {
        color: var(--color-text-primary);
      }
    }

    :global(.aside__list--has-active) :global(.aside__link) {
      opacity: 0.45;
    }

    :global(.aside__list--has-active) :global(.aside__link--active) {
      color: var(--color-text-primary);
      font-weight: $font-medium;
      opacity: 1;
    }

    :global(.aside__list--has-active) :global(.aside__link:hover) {
      opacity: 1;
    }
  }
</style>
