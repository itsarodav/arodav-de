---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const externalLinks = [
  { label: t('footer.linkedin'), href: 'https://www.linkedin.com/in/arodav/' },
  { label: t('footer.github'), href: 'https://github.com/itsarodav' },
  { label: t('footer.email'), href: 'mailto:hi@arodav.com' },
];
---

<footer class="footer">
  <div class="footer__divider" aria-hidden="true"></div>
  <div class="footer__links">
    {externalLinks.map((link) => (
      <a
        class="footer__link"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {link.label}
        <Icon name="arrow-out" size={14} color="currentColor" role="decorative" />
      </a>
    ))}
    <a class="footer__link footer__link--download" href="#" download>
      {t('footer.resume')}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M12 3v14m0 0l-5-5m5 5l5-5M5 20h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  <p class="footer__crafted">
    {t('footer.crafted_prefix')}
    <Icon name="heart" size={12} color="currentColor" role="decorative" />
    {t('footer.crafted_mid')}
    <Icon name="headphones" size={12} color="currentColor" role="decorative" />
    {t('footer.crafted_suffix')}
  </p>
</footer>

<style lang="scss">
  @use '../styles/tokens' as *;

  .footer {
    margin-top: $space-16;
    padding-bottom: $space-8;

    &__divider {
      width: $space-12;
      height: 2px;
      background-color: var(--color-border);
      margin-bottom: $space-8;
    }

    &__links {
      display: flex;
      flex-wrap: wrap;
      gap: $space-4 $space-6;
      margin-bottom: $space-6;
    }

    &__link {
      display: inline-flex;
      align-items: center;
      gap: $space-1;
      font-size: $text-sm;
      font-weight: $font-medium;
      letter-spacing: $tracking-normal;
      color: var(--color-link);
      transition: color 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);

      &:hover {
        color: var(--color-text-primary);
      }

      &--download {
        svg {
          display: block;
        }
      }
    }

    &__crafted {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      gap: $space-1;

      :global(svg) {
        display: inline-block;
        flex-shrink: 0;
      }
      font-size: $text-xs;
      font-weight: $font-medium;
      letter-spacing: $tracking-wider;
      color: var(--color-text-tertiary);
    }
  }
</style>
