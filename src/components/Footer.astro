---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const externalLinks = [
  { label: t('footer.linkedin'), href: 'https://www.linkedin.com/in/arodav/' },
  { label: t('footer.github'), href: 'https://github.com/itsarodav' },
];

const resumePath = lang === 'es'
  ? '/cv/Andrea_Robles_CV_ES.pdf'
  : '/cv/Andrea_Robles_Resume_EN.pdf';
---

<footer class="footer">
  <div class="footer__divider" aria-hidden="true"></div>
  <div class="footer__links">
    {externalLinks.map((link) => (
      <a
        class="footer__link"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {link.label}
        <Icon name="arrow-out" size={14} color="currentColor" role="decorative" />
      </a>
    ))}
    <button class="footer__link footer__copy" type="button" data-copy="hi@arodav.com">
      {t('footer.email')}
      <span class="footer__copy-wrap">
        <svg class="footer__copy-blur" width="0" height="0" aria-hidden="true">
          <filter id="copy-motion-blur">
            <feGaussianBlur in="SourceGraphic" stdDeviation="0 0" />
          </filter>
        </svg>
        <span class="footer__copy-icon footer__copy-icon--copy">
          <Icon name="copy-btn" size={14} color="currentColor" role="decorative" />
        </span>
        <svg class="footer__copy-icon footer__copy-icon--check" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 1C5.925 1 1 5.925 1 12s4.925 11 11 11 11-4.925 11-11S18.075 1 12 1zm4.768 8.36a1 1 0 10-1.536-1.28l-4.3 5.159-1.965-1.965a1 1 0 00-1.414 1.414l2.75 2.75a1 1 0 001.475-.067l5-6z" />
        </svg>
      </span>
    </button>
    <a class="footer__link footer__link--download" href={resumePath} download>
      {t('footer.resume')}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M12 3v14m0 0l-5-5m5 5l5-5M5 20h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  <p class="footer__crafted">
    {t('footer.crafted_prefix')}
    <Icon name="heart" size={12} color="currentColor" role="decorative" />
    {t('footer.crafted_mid')}
    <Icon name="headphones" size={12} color="currentColor" role="decorative" />
    {t('footer.crafted_suffix')}
  </p>
</footer>

<style lang="scss">
  @use '../styles/tokens' as *;

  .footer {
    margin-top: $space-16;
    padding-bottom: $space-8;

    &__divider {
      width: $space-12;
      height: 2px;
      background-color: var(--color-border);
      margin-bottom: $space-8;
    }

    &__links {
      display: flex;
      flex-wrap: wrap;
      gap: $space-4 $space-6;
      margin-bottom: $space-6;
    }

    &__link {
      display: inline-flex;
      align-items: center;
      gap: $space-1;
      font-size: $text-sm;
      font-weight: $font-medium;
      letter-spacing: $tracking-normal;
      color: var(--color-link);
      transition: color 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);

      @media (hover: hover) {
        &:hover {
          color: var(--color-text-primary);
        }
      }

      &--download {
        svg {
          display: block;
        }
      }
    }

    &__copy {
      border: none;
      background: none;
      padding: 0;
      cursor: pointer;
      font-family: inherit;
      position: relative;
    }

    &__copy-blur {
      position: absolute;
      pointer-events: none;
    }

    &__copy-wrap {
      position: relative;
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    &__copy-icon {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      filter: url(#copy-motion-blur);

      :global(svg) {
        display: block;
      }

      &--copy {
        opacity: 1;
        transform: scale(1);
      }

      &--check {
        opacity: 0;
        transform: scale(0.5);
      }
    }

    &__copy[data-copied] {
      .footer__copy-icon--copy {
        opacity: 0;
        transform: scale(0.5);
      }

      .footer__copy-icon--check {
        opacity: 1;
        transform: scale(1);
      }
    }

    &__crafted {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      gap: $space-1;

      :global(svg) {
        display: inline-block;
        flex-shrink: 0;
      }
      font-size: $text-xs;
      font-weight: $font-medium;
      letter-spacing: $tracking-wider;
      color: var(--color-text-tertiary);
    }
  }
</style>

<script>
  function animateBlur(blur: SVGFEGaussianBlurElement, stdY: number, duration: number): Promise<void> {
    return new Promise((resolve) => {
      const start = performance.now();
      const peak = stdY;

      function tick(now: number) {
        const t = Math.min((now - start) / duration, 1);
        // ease-out: ramp up fast, settle back to 0
        const value = peak * Math.sin(t * Math.PI);
        blur.setAttribute('stdDeviation', `0 ${value.toFixed(2)}`);
        if (t < 1) {
          requestAnimationFrame(tick);
        } else {
          blur.setAttribute('stdDeviation', '0 0');
          resolve();
        }
      }

      requestAnimationFrame(tick);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.footer__copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }

      const blur = btn.querySelector<SVGFEGaussianBlurElement>('#copy-motion-blur feGaussianBlur');
      if (blur) animateBlur(blur, 1.5, 300);

      btn.setAttribute('data-copied', '');
      setTimeout(() => {
        const blurEl = btn.querySelector<SVGFEGaussianBlurElement>('#copy-motion-blur feGaussianBlur');
        if (blurEl) animateBlur(blurEl, 1.5, 300);
        btn.removeAttribute('data-copied');
      }, 2000);
    });
  });
</script>
