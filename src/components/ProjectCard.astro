---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  name: string;
  description: string;
  href: string;
  ariaLabel?: string;
  external?: boolean;
}

const { icon, name, description, href, ariaLabel, external = true } = Astro.props;
const isExternal = external && href !== '#';
---

<a
  class="project-card"
  href={href}
  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  aria-label={ariaLabel || `${name} -${description}`}
>
  <div class="project-card__icon">
    <Icon name={icon} size={32} role="decorative" />
  </div>
  <div class="project-card__content">
    <span class="project-card__name">{name}</span>
    <span class="project-card__description">{description}</span>
  </div>
  <div class="project-card__arrow">
    <Icon name="arrow-out" size={20} role="decorative" />
  </div>
</a>

<style lang="scss">
  @use '../styles/tokens' as *;

  .project-card {
    display: flex;
    align-items: center;
    gap: $space-4;
    padding: $space-3 0;
    border-radius: 12px;
    transition: opacity 0.2s ease;

    &__icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 10px;

      :global(svg) {
        width: 24px;
        height: 24px;
      }

      @include respond-to(md) {
        width: 56px;
        height: 56px;
        border-radius: 12px;

        :global(svg) {
          width: 32px;
          height: 32px;
        }
      }
    }

    &__content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: $space-1;
    }

    &__name {
      font-size: $text-sm;
      font-weight: $font-semibold;
      letter-spacing: $tracking-tight;
      color: var(--color-text-primary);

      @include respond-to(md) {
        font-size: $text-base;
      }
    }

    &__description {
      font-size: $text-sm;
      letter-spacing: $tracking-wide;
      color: var(--color-text-tertiary);

      @include respond-to(md) {
        font-size: $text-base;
      }
    }

    &__arrow {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      color: var(--color-text-secondary);
    }
  }
</style>
