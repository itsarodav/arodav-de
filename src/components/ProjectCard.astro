---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  name: string;
  description: string;
  href: string;
  ariaLabel?: string;
  external?: boolean;
}

const { icon, name, description, href, ariaLabel, external = true } = Astro.props;
const isExternal = external && href !== '#';
---

<a
  class="project-card"
  href={href}
  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  aria-label={ariaLabel || `${name} -${description}`}
>
  <Icon name={icon} size={24} role="decorative" />
  <div class="project-card__content">
    <span class="project-card__name">{name}</span>
    <span class="project-card__description">{description}</span>
  </div>
  <div class="project-card__arrow">
    <Icon name={isExternal ? 'arrow-out' : 'arrow-right'} size={20} role="decorative" />
  </div>
</a>

<style lang="scss">
  @use '../styles/tokens' as *;

  .project-card {
    display: flex;
    align-items: center;
    gap: $space-6;
    padding: $space-3 0;
    border-radius: 12px;
    transition: opacity 0.2s ease;

    &__content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: $space-1;
    }

    &__name {
      font-size: $text-sm;
      font-weight: $font-semibold;
      letter-spacing: $tracking-tight;
      color: var(--color-text-primary);

      @include respond-to(md) {
        font-size: $text-base;
      }
    }

    &__description {
      font-size: $text-sm;
      letter-spacing: $tracking-wide;
      color: var(--color-text-tertiary);

      @include respond-to(md) {
        font-size: $text-base;
      }
    }

    &__arrow {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      color: var(--color-text-secondary);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initProjectCardAnimations() {
    if (!window.matchMedia('(hover: hover)').matches) return;

    document.querySelectorAll<HTMLAnchorElement>('.project-card').forEach((card) => {
      const svg = card.querySelector('svg');
      if (!svg) return;

      let anim: gsap.core.Tween | gsap.core.Timeline | null = null;

      // ── RIFFIMS (album) — Vinyl spin ──
      if (svg.classList.contains('icon--album')) {
        card.addEventListener('mouseenter', () => {
          if (anim) anim.kill();
          anim = gsap.to(svg, {
            rotation: '+=360',
            duration: 2,
            ease: 'none',
            repeat: -1,
            transformOrigin: '50% 50%',
          });
        });

        card.addEventListener('mouseleave', () => {
          if (anim) anim.kill();
          const r = Number(gsap.getProperty(svg, 'rotation'));
          const target = Math.ceil(r / 360) * 360;
          anim = gsap.to(svg, {
            rotation: target || 360,
            duration: 0.6,
            ease: 'power3.out',
            onComplete() {
              gsap.set(svg, { rotation: 0 });
            },
          });
        });
      }

      // ── LINKIMS (theme) — Looping circle swap ──
      if (svg.classList.contains('icon--theme')) {
        const paths = Array.from(svg.querySelectorAll('path'));
        // [0] BL square  [1] BR square  [2] TL square  [3] TR circle
        const OFFSET = 13.2;
        const origin: [number, number][] = [
          [0, 1], [1, 1], [0, 0], [1, 0],
        ];
        const pos = origin.map((p) => [...p] as [number, number]);
        let hovered = false;
        let delayed: gsap.core.Tween | null = null;

        function applyTranslate(idx: number, dur: number, onDone?: () => void) {
          gsap.to(paths[idx], {
            x: (pos[idx][0] - origin[idx][0]) * OFFSET,
            y: (pos[idx][1] - origin[idx][1]) * OFFSET,
            duration: dur,
            ease: 'power2.inOut',
            onComplete: onDone,
          });
        }

        function swapLoop() {
          if (!hovered) return;
          // Pick a random square that is NOT already where the circle is
          const circlePos = pos[3];
          const candidates = [0, 1, 2].filter(
            (i) => pos[i][0] !== circlePos[0] || pos[i][1] !== circlePos[1],
          );
          const sqIdx = candidates[Math.floor(Math.random() * candidates.length)];

          // Swap grid positions
          const tmp: [number, number] = [...pos[3]];
          pos[3] = [...pos[sqIdx]];
          pos[sqIdx] = tmp;

          applyTranslate(3, 0.5);
          applyTranslate(sqIdx, 0.5, () => {
            if (hovered) delayed = gsap.delayedCall(0.8, swapLoop);
          });
        }

        card.addEventListener('mouseenter', () => {
          hovered = true;
          if (delayed) delayed.kill();
          paths.forEach((p) => gsap.killTweensOf(p));
          // Reset
          gsap.set(paths, { x: 0, y: 0 });
          for (let i = 0; i < 4; i++) pos[i] = [...origin[i]];
          swapLoop();
        });

        card.addEventListener('mouseleave', () => {
          hovered = false;
          if (delayed) delayed.kill();
          paths.forEach((p) => gsap.killTweensOf(p));
          gsap.to(paths, { x: 0, y: 0, duration: 0.4, ease: 'power2.out' });
          for (let i = 0; i < 4; i++) pos[i] = [...origin[i]];
        });
      }

      // ── PRELUDE ICONS (bundle-box) — Icon silhouette morph ──
      if (svg.classList.contains('icon--bundle-box')) {
        const innerPath = svg.querySelector('.box-inner') as SVGPathElement | null;

        if (innerPath) {
          const P = 24; // points per shape

          // ── Helpers ──
          function resample(verts: number[][], n: number): number[][] {
            const lens: number[] = [];
            let total = 0;
            for (let i = 0; i < verts.length; i++) {
              const b = verts[(i + 1) % verts.length];
              const l = Math.hypot(b[0] - verts[i][0], b[1] - verts[i][1]);
              lens.push(l);
              total += l;
            }
            const step = total / n;
            const out: number[][] = [];
            for (let i = 0; i < n; i++) {
              let d = i * step;
              let ei = 0;
              while (ei < lens.length - 1 && d > lens[ei]) {
                d -= lens[ei];
                ei++;
              }
              const t = lens[ei] > 0 ? d / lens[ei] : 0;
              const a = verts[ei],
                b = verts[(ei + 1) % verts.length];
              out.push([a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]);
            }
            return out;
          }

          function mCircle(r: number) {
            return Array.from({ length: P }, (_, i) => {
              const a = (i / P) * Math.PI * 2;
              return [16 + r * Math.cos(a), 16 + r * Math.sin(a)];
            });
          }

          function mStar(ro: number, ri: number) {
            const v: number[][] = [];
            for (let i = 0; i < 10; i++) {
              const a = (i / 10) * Math.PI * 2 - Math.PI / 2;
              v.push([16 + (i % 2 === 0 ? ro : ri) * Math.cos(a), 16 + (i % 2 === 0 ? ro : ri) * Math.sin(a)]);
            }
            return resample(v, P);
          }

          function mHeart(s: number) {
            const cy = 15;
            const raw: number[][] = [];
            for (let i = 0; i < 60; i++) {
              const t = (i / 60) * Math.PI * 2;
              raw.push([
                16 + s * Math.sin(t) ** 3,
                cy - (s * (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t))) / 16,
              ]);
            }
            return resample(raw, P);
          }

          function mHexagon(r: number) {
            const v: number[][] = [];
            for (let i = 0; i < 6; i++) {
              const a = (i / 6) * Math.PI * 2 - Math.PI / 2;
              v.push([16 + r * Math.cos(a), 16 + r * Math.sin(a)]);
            }
            return resample(v, P);
          }

          function lerpPts(a: number[][], b: number[][], t: number): number[][] {
            return a.map((p, i) => [p[0] + (b[i][0] - p[0]) * t, p[1] + (b[i][1] - p[1]) * t]);
          }

          function toD(pts: number[][]): string {
            return 'M' + pts.map((p) => `${p[0].toFixed(2)} ${p[1].toFixed(2)}`).join('L') + 'Z';
          }

          // Sample original path into point array
          const pathLen = innerPath.getTotalLength();
          const originalPts = Array.from({ length: P }, (_, i) => {
            const pt = innerPath.getPointAtLength((i / P) * pathLen);
            return [pt.x, pt.y];
          });

          const shapes = [mCircle(5.2), mStar(6.8, 3), mHeart(4.6), mHexagon(5.2)];
          let currentPts = originalPts.map((p) => [...p]);
          let morphActive = false;
          let morphTween: gsap.core.Tween | null = null;

          function morphTo(target: number[][], dur: number, ease: string, onDone?: () => void) {
            const from = currentPts.map((p) => [...p]);
            const proxy = { t: 0 };
            morphTween = gsap.to(proxy, {
              t: 1,
              duration: dur,
              ease,
              onUpdate() {
                currentPts = lerpPts(from, target, proxy.t);
                innerPath.setAttribute('d', toD(currentPts));
              },
              onComplete: onDone,
            });
          }

          function morphLoop(idx: number) {
            if (!morphActive) return;
            morphTo(shapes[idx], 1.3, 'back.out(1.4)', () => {
              if (morphActive) morphLoop((idx + 1) % shapes.length);
            });
          }

          card.addEventListener('mouseenter', () => {
            morphActive = true;
            if (morphTween) morphTween.kill();
            morphTo(shapes[0], 0.8, 'back.out(1.4)', () => {
              if (morphActive) morphLoop(1);
            });
          });

          card.addEventListener('mouseleave', () => {
            morphActive = false;
            if (morphTween) morphTween.kill();
            morphTo(originalPts, 0.45, 'power2.out');
          });
        }
      }

      // ── TERMINAL (MDDS) — Chevron slides right, cursor shrinks ──
      if (svg.classList.contains('icon--terminal')) {
        const chevron = svg.querySelector('.terminal-chevron');
        const cursor = svg.querySelector('.terminal-cursor');

        if (chevron && cursor) {
          card.addEventListener('mouseenter', () => {
            if (anim) anim.kill();
            gsap.killTweensOf([chevron, cursor]);
            anim = gsap.timeline({ repeat: -1, repeatDelay: 0.6 })
              .to(chevron, { x: 4.5, duration: 0.35, ease: 'back.out(3)' }, 0)
              .to(cursor, { x: 1.5, scaleX: 0.6, transformOrigin: '100% 50%', duration: 0.35, ease: 'power2.out' }, 0)
              .to(chevron, { x: 0, duration: 0.5, ease: 'power3.inOut' }, 0.6)
              .to(cursor, { x: 0, scaleX: 1, transformOrigin: '100% 50%', duration: 0.5, ease: 'power3.inOut' }, 0.6);
          });

          card.addEventListener('mouseleave', () => {
            if (anim) anim.kill();
            gsap.to(chevron, { x: 0, duration: 0.4, ease: 'power2.out' });
            gsap.to(cursor, { x: 0, scaleX: 1, transformOrigin: '100% 50%', duration: 0.4, ease: 'power2.out' });
          });
        }
      }
    });
  }

  initProjectCardAnimations();
</script>
