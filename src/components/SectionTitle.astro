---
interface Props {
  title: string;
  tag?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { title, tag: Tag = 'h2', class: className = '' } = Astro.props;
---

<Tag class:list={['section-title', className]}>{title}</Tag>

<style lang="scss">
  @use '../styles/tokens' as *;

  .section-title {
    font-size: $text-base;
    font-weight: $font-medium;
    letter-spacing: $tracking-normal;
    color: var(--color-text-tertiary);
    margin-bottom: $space-8;
  }
</style>
