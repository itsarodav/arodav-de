          </svg>
        </span>
      </button>
    </div>
  </nav>
</header>

<script>
  const topbar = document.querySelector('.topbar');
  if (topbar) {
    const onScroll = () => {
      if (window.scrollY > 10) {
        topbar.classList.add('topbar--scrolled');
      } else {
        topbar.classList.remove('topbar--scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: $space-2 $space-4;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;

    &.topbar--scrolled {
      background: rgba(255, 255, 255, 0.45);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    @include respond-to(md) {
      padding: $space-2 $space-6;
    }

    &__nav {
      display: flex;
      justify-content: flex-end;
      max-width: 640px;
      margin: 0 auto;
    }

    &__actions {
      display: flex;
      align-items: center;
      gap: $space-1;
    }

    &__menu-btn {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      color: var(--color-icon-default);
      transition: color 0.2s ease, background-color 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);

      &:hover {
        color: var(--color-text-primary);
        background-color: rgba($color-light-gray, 0.35);
      }
    }

    &__menu-icon {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);

      &--open {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }

      &--close {
        opacity: 0;
        transform: rotate(-90deg) scale(0.5);
      }
    }

    &__menu-btn[aria-expanded='true'] {
      .topbar__menu-icon--open {
        opacity: 0;
        transform: rotate(90deg) scale(0.5);
      }

      .topbar__menu-icon--close {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
    }
  }

  :global([data-theme='dark']) .topbar {
    &.topbar--scrolled {
      background: rgba(10, 10, 10, 0.45);
    }
  }
</style>
