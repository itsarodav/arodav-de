---
import { useTranslations } from '@/i18n';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cards = [
  {
    x: 0, delivered: true,
    status: t('case.prelude.roadmap.delivered'),
    title: t('case.prelude.roadmap.gallery'),
    sub1: t('case.prelude.roadmap.gallery_sub1'),
    sub2: t('case.prelude.roadmap.gallery_sub2'),
  },
  {
    x: 198, delivered: false,
    status: t('case.prelude.roadmap.next'),
    title: t('case.prelude.roadmap.qa'),
    sub1: t('case.prelude.roadmap.qa_sub1'),
    sub2: t('case.prelude.roadmap.qa_sub2'),
  },
  {
    x: 396, delivered: false,
    status: t('case.prelude.roadmap.later'),
    title: t('case.prelude.roadmap.package'),
    sub1: t('case.prelude.roadmap.package_sub1'),
    sub2: t('case.prelude.roadmap.package_sub2'),
  },
  {
    x: 594, delivered: false,
    status: t('case.prelude.roadmap.later'),
    title: t('case.prelude.roadmap.figma'),
    sub1: t('case.prelude.roadmap.figma_sub1'),
    sub2: t('case.prelude.roadmap.figma_sub2'),
  },
];

const chevronXs = [375, 573];
---

<figure class="prelude-roadmap" role="img" aria-label={t('case.prelude.roadmap.title_sr')}>
  <svg
    viewBox="0 0 760 200"
    xmlns="http://www.w3.org/2000/svg"
    class="prelude-roadmap__svg"
  >
    <!-- TODAY marker -->
    <text class="pr-today" x="182" y="42" text-anchor="middle">{t('case.prelude.roadmap.today')}</text>
    <line x1="182" y1="54" x2="182" y2="200" class="pr-today-line" />

    <!-- Cards -->
    {cards.map((card, i) => (
      <g class="pr-card" data-index={i}>
        {card.delivered ? (
          <rect
            x={card.x} y="70" width="166" height="112" rx="8"
            class="pr-card-bg pr-card-bg--delivered"
          />
        ) : (
          <rect
            x={card.x} y="70" width="166" height="112" rx="8"
            class="pr-card-bg pr-card-bg--future"
          />
        )}

        {card.delivered && (
          <g>
            <circle cx={card.x + 22} cy="92" r="6.5" class="pr-check-circle" />
            <path
              d={`M${card.x + 19} 92 l2.2 2.2 l4-4.6`}
              class="pr-check-mark"
            />
          </g>
        )}

        <text
          class={`pr-status ${card.delivered ? 'pr-status--delivered' : ''}`}
          x={card.delivered ? card.x + 36 : card.x + 16}
          y="96"
        >
          {card.status}
        </text>
        <text class="pr-title" x={card.x + 16} y="124">{card.title}</text>
        <text class="pr-sub" x={card.x + 16} y="146">{card.sub1}</text>
        <text class="pr-sub" x={card.x + 16} y="162">{card.sub2}</text>
      </g>
    ))}

    <!-- Chevrons between cards -->
    {chevronXs.map((cx) => (
      <path
        d={`M${cx} 121 l6 5 l-6 5`}
        class="pr-chevron"
      />
    ))}

  </svg>
  <figcaption class="prelude-roadmap__caption">{t('case.prelude.roadmap.caption')}</figcaption>
</figure>

<script>
  import { gsap } from 'gsap';

  const diagram = document.querySelector('.prelude-roadmap');
  if (diagram) {
    const cards = diagram.querySelectorAll('.pr-card');

    cards.forEach((card, i) => {
      gsap.from(card, {
        opacity: 0,
        y: 16,
        duration: 0.6,
        delay: 0.15 + i * 0.18,
        ease: 'power2.out',
      });
    });

    // Pulse on the delivered check circle
    const checkCircle = diagram.querySelector('.pr-check-circle');
    if (checkCircle) {
      gsap.to(checkCircle, {
        attr: { r: 7.5 },
        duration: 1.4,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
        delay: 1,
      });
    }
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .prelude-roadmap {
    margin: $space-12 0;
    padding: $space-4 0;
  }

  .prelude-roadmap__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .prelude-roadmap__caption {
    text-align: center;
    font-size: $text-sm;
    color: var(--color-text-tertiary);
    margin-top: $space-6;
    line-height: $line-normal;
  }

  .pr-today {
    fill: currentColor;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .pr-today-line {
    stroke: currentColor;
    stroke-opacity: 0.3;
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
  }

  .pr-card-bg--delivered {
    fill: var(--color-link);
    fill-opacity: 0.07;
    stroke: var(--color-link);
    stroke-opacity: 0.8;
    stroke-width: 1.5;
  }

  .pr-card-bg--future {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.32;
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }

  .pr-check-circle {
    fill: var(--color-link);
  }

  .pr-check-mark {
    fill: none;
    stroke: #fff;
    stroke-opacity: 0.95;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pr-status {
    fill: currentColor;
    font-size: 11px;
    font-weight: 500;
    opacity: 0.55;
  }

  .pr-status--delivered {
    fill: var(--color-link);
    opacity: 1;
  }

  .pr-title {
    fill: currentColor;
    font-size: 14.5px;
    font-weight: 600;
  }

  .pr-sub {
    fill: currentColor;
    font-size: 11.5px;
    opacity: 0.55;
  }

  .pr-chevron {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.3;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

</style>
