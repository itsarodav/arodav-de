---
import { useTranslations, getAlternatePath, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);

const alternateLang = lang === 'en' ? 'es' : 'en';
const alternatePath = getAlternatePath(currentPath, alternateLang as any);

const homePath = lang === 'es' ? '/es' : '/';
const writingPath = lang === 'es' ? '/es/writing' : '/writing';

const navLinks = [
  { label: t('nav.home'), href: homePath },
  { label: t('nav.writing'), href: writingPath },
  { label: t('nav.design'), href: '#' },
];
---

<div class="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__backdrop" data-menu-close></div>
  <div class="mobile-menu__panel">
    <nav class="mobile-menu__nav" aria-label={t('nav.main')}>
      <ul class="mobile-menu__list">
        {navLinks.map((link) => (
          <li>
            <a
              class="mobile-menu__link"
              href={link.href}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="mobile-menu__lang-btn"
        href={alternatePath}
        aria-label={t('nav.language_label')}
      >
        {t('nav.language')}
      </a>
    </nav>
  </div>
</div>

<style lang="scss">
  @use '../styles/tokens' as *;

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;

    &[aria-hidden='false'] {
      pointer-events: auto;

      .mobile-menu__backdrop {
        opacity: 1;
      }

      .mobile-menu__panel {
        transform: translateX(0);
      }
    }

    &__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    &__panel {
      position: absolute;
      inset: 0;
      background-color: var(--color-bg-primary);
      transform: translateX(100%);
      transition: transform 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: calc($space-8 + 3rem) $space-4 $space-8;
    }

    &__nav {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 100%;
      max-width: 640px;
    }

    &__list {
      display: flex;
      flex-direction: column;
      gap: $space-6;
    }

    &__link {
      font-size: $text-2xl;
      font-weight: $font-medium;
      letter-spacing: $tracking-tighter;
      color: var(--color-text-primary);
      transition: color 0.2s ease;

      &:hover,
      &[aria-current='page'] {
        color: var(--color-link);
      }
    }

    &__lang-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      padding: $space-2 $space-4;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font-size: $text-sm;
      font-weight: $font-semibold;
      letter-spacing: $tracking-tight;
      color: var(--color-text-secondary);
      transition: border-color 0.2s ease, color 0.2s ease;

      &:hover {
        border-color: var(--color-text-primary);
        color: var(--color-text-primary);
      }
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var menu = document.querySelector('[data-mobile-menu]');
    if (!menu) return;

    var toggleBtns = document.querySelectorAll('[data-menu-toggle]');
    var closeBtns = menu.querySelectorAll('[data-menu-close]');

    function open() {
      menu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      toggleBtns.forEach(function (btn) { btn.setAttribute('aria-expanded', 'true'); });
      var firstLink = menu.querySelector('a');
      if (firstLink) firstLink.focus();
    }

    function close() {
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      toggleBtns.forEach(function (btn) { btn.setAttribute('aria-expanded', 'false'); });
      var trigger = document.querySelector('[data-menu-toggle]');
      if (trigger) trigger.focus();
    }

    toggleBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var isOpen = menu.getAttribute('aria-hidden') === 'false';
        if (isOpen) { close(); } else { open(); }
      });
    });

    closeBtns.forEach(function (btn) { btn.addEventListener('click', close); });

    menu.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  });
</script>
