---
import { useTranslations } from '@/i18n';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Bar proportions — total Prelude width = 152.6 (JS 65.8 + CSS 86.8)
// React bar = 560
const barH = 34;
const preludeTotal = 152.6;
const jsW = 65.8;
const reactW = 560;
---

<figure class="prelude-bundle" role="img" aria-label={t('case.prelude.bundle.title_sr')}>
  <svg
    viewBox="0 0 700 200"
    xmlns="http://www.w3.org/2000/svg"
    class="prelude-bundle__svg"
  >
    <!-- Row 1: Prelude -->
    <text class="pb-label" x="0" y="24">{t('case.prelude.bundle.prelude_label')}</text>

    <!-- Grey track (full width of Prelude total) -->
    <rect class="pb-track" x="0" y="36" width={preludeTotal} height={barH} rx="4" />
    <!-- Accent fill (JS portion) on top -->
    <rect class="pb-accent" x="0" y="36" width={jsW} height={barH} rx="4" />
    <!-- Value label -->
    <text class="pb-value" x={preludeTotal + 14} y="59">{t('case.prelude.bundle.prelude_value')}</text>

    <!-- Segment labels -->
    <text class="pb-seg" x="0" y="88">{t('case.prelude.bundle.js')}</text>
    <text class="pb-seg" x={jsW} y="88">{t('case.prelude.bundle.css')}</text>

    <!-- Row 2: React -->
    <text class="pb-label" x="0" y="136">{t('case.prelude.bundle.react_label')}</text>

    <rect class="pb-react" x="0" y="148" width={reactW} height={barH} rx="4" />
    <text class="pb-value" x={reactW + 14} y="171">{t('case.prelude.bundle.react_value')}</text>

    <text class="pb-multiplier" x="0" y="200">{t('case.prelude.bundle.multiplier')}</text>
  </svg>
  <figcaption class="prelude-bundle__caption">{t('case.prelude.bundle.caption')}</figcaption>
</figure>

<script>
  import { gsap } from 'gsap';

  const diagram = document.querySelector('.prelude-bundle');
  if (diagram) {
    const accent = diagram.querySelector('.pb-accent');
    const track = diagram.querySelector('.pb-track');
    const react = diagram.querySelector('.pb-react');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (track) {
              gsap.from(track, {
                attr: { width: 0 },
                duration: 0.8,
                delay: 0.15,
                ease: 'power2.out',
              });
            }
            if (accent) {
              gsap.from(accent, {
                attr: { width: 0 },
                duration: 0.7,
                delay: 0.2,
                ease: 'power2.out',
              });
            }
            if (react) {
              gsap.from(react, {
                attr: { width: 0 },
                duration: 1.2,
                delay: 0.4,
                ease: 'power2.out',
              });
            }
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(diagram);
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .prelude-bundle {
    margin: $space-12 0;
    padding: $space-4 0;
  }

  .prelude-bundle__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .prelude-bundle__caption {
    text-align: center;
    font-size: $text-sm;
    color: var(--color-text-tertiary);
    margin-top: $space-8;
    line-height: $line-normal;
  }

  .pb-label {
    fill: currentColor;
    font-size: 15.5px;
    font-weight: 600;
  }

  .pb-value {
    fill: currentColor;
    font-size: 15.5px;
    font-weight: 600;
  }

  .pb-seg {
    fill: currentColor;
    font-size: 11.5px;
    opacity: 0.55;
  }

  .pb-multiplier {
    fill: currentColor;
    font-size: 12px;
    opacity: 0.55;
  }

  .pb-track {
    fill: currentColor;
    fill-opacity: 0.12;
  }

  .pb-accent {
    fill: var(--color-link);
    fill-opacity: 0.85;
  }

  .pb-react {
    fill: currentColor;
    fill-opacity: 0.10;
    stroke: currentColor;
    stroke-opacity: 0.25;
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }
</style>
