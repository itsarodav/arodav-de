---
import { useTranslations } from '@/i18n';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Bottom-aligned: all icons share the same baseline at y=133
const baseY = 133;
const sizes = [
  { px: 16, x: 40, y: baseY - 16, w: 16, h: 16 },
  { px: 20, x: 128.8, y: baseY - 20, w: 20, h: 20 },
  { px: 24, x: 221.6, y: baseY - 24, w: 24, h: 24 },
  { px: 32, x: 318.4, y: baseY - 32, w: 32, h: 32 },
  { px: 48, x: 423.2, y: baseY - 48, w: 48, h: 48 },
  { px: 56, x: 544, y: baseY - 56, w: 56, h: 56 },
];

const labelXs = [48, 138.8, 233.6, 334.4, 447.2, 572];
---

<figure class="prelude-sizes" role="img" aria-label={t('case.prelude.sizes.title_sr')}>
  <svg
    viewBox="0 0 640 170"
    xmlns="http://www.w3.org/2000/svg"
    class="prelude-sizes__svg"
  >
    <defs>
      <symbol id="pi-export" viewBox="0 0 24 24">
        <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 v11.5" />
          <path d="M7.5 10.2 L12 14.7 L16.5 10.2" />
          <path d="M4 19.5 h16" />
        </g>
      </symbol>
    </defs>

    <!-- Top bracket -->
    <path d="M40 40 v6 M40 40 H600 M600 40 v6" class="ps-bracket" />
    <text class="ps-bracket-label" x="320" y="30" text-anchor="middle">{t('case.prelude.sizes.bracket')}</text>

    <!-- Icons at increasing sizes -->
    {sizes.map((s, i) => (
      <use
        href="#pi-export"
        x={s.x}
        y={s.y}
        width={s.w}
        height={s.h}
        class="ps-icon"
        data-index={i}
      />
    ))}

    <!-- Size labels -->
    {sizes.map((s, i) => (
      <text class="ps-label" x={labelXs[i]} y="160" text-anchor="middle">{s.px}</text>
    ))}
  </svg>
  <figcaption class="prelude-sizes__caption">{t('case.prelude.sizes.caption')}</figcaption>
</figure>

<script>
  import { gsap } from 'gsap';

  const diagram = document.querySelector('.prelude-sizes');
  if (diagram) {
    const icons = diagram.querySelectorAll('.ps-icon');

    icons.forEach((icon, i) => {
      gsap.from(icon, {
        opacity: 0,
        y: 12,
        duration: 0.5,
        delay: 0.2 + i * 0.12,
        ease: 'back.out(2)',
      });
    });
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .prelude-sizes {
    margin: $space-12 0;
    padding: $space-4 0;
  }

  .prelude-sizes__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .prelude-sizes__caption {
    text-align: center;
    font-size: $text-sm;
    color: var(--color-text-tertiary);
    margin-top: $space-6;
    line-height: $line-normal;
  }

  .ps-bracket {
    fill: none;
    stroke: var(--color-link);
    stroke-opacity: 0.55;
    stroke-width: 1.4;
  }

  .ps-bracket-label {
    fill: var(--color-link);
    font-size: 13px;
    font-weight: 500;
  }

  .ps-icon {
    color: currentColor;
  }

  .ps-label {
    fill: currentColor;
    font-size: 11.5px;
    opacity: 0.55;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

</style>
