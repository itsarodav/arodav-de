---
import { useTranslations } from '@/i18n';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { title: t('case.prelude.codegen.step1'), sub: t('case.prelude.codegen.step1_sub') },
  { title: t('case.prelude.codegen.step2'), sub: t('case.prelude.codegen.step2_sub') },
  { title: t('case.prelude.codegen.step3'), sub: t('case.prelude.codegen.step3_sub') },
];

const outputs = [
  t('case.prelude.codegen.out1'),
  t('case.prelude.codegen.out2'),
  t('case.prelude.codegen.out3'),
  t('case.prelude.codegen.out4'),
  t('case.prelude.codegen.out5'),
];

// Layout constants
const viewW = 760;
const viewH = 280;
const stationY = 140;
const stationXs = [80, 240, 420];

// Fan-out outputs: 5 items vertically distributed on the right
const outX = 620;
const outStartY = 52;
const outGap = 46;
---

<figure class="prelude-codegen" role="img" aria-label={t('case.prelude.codegen.title_sr')}>
  <svg
    viewBox={`0 0 ${viewW} ${viewH}`}
    xmlns="http://www.w3.org/2000/svg"
    class="prelude-codegen__svg"
  >
    <!-- horizontal rail from step 1 to step 3 -->
    <line
      x1={stationXs[0]} y1={stationY}
      x2={stationXs[2]} y2={stationY}
      class="pc-rail"
    />

    <!-- chevrons between input stations -->
    {stationXs.slice(1).map((x) => (
      <path
        d={`M${x - 18} ${stationY - 5} l6 5 l-6 5`}
        class="pc-chevron"
      />
    ))}

    <!-- input stations -->
    <circle cx={stationXs[0]} cy={stationY} r="7" class="pc-station pc-station--active" />
    {stationXs.slice(1).map((cx) => (
      <g>
        <circle cx={cx} cy={stationY} r="7" class="pc-station" />
        <circle cx={cx} cy={stationY} r="2.6" class="pc-station-dot" />
      </g>
    ))}

    <!-- input labels -->
    {steps.map((step, i) => (
      <g>
        <text class="pc-title" x={stationXs[i]} y={stationY - 28} text-anchor="middle">{step.title}</text>
        <text class="pc-sub" x={stationXs[i]} y={stationY - 12} text-anchor="middle">{step.sub}</text>
      </g>
    ))}

    <!-- fan-out lines from step 3 to each output -->
    {outputs.map((_, i) => {
      const oy = outStartY + i * outGap;
      return (
        <line
          x1={stationXs[2]} y1={stationY}
          x2={outX - 24} y2={oy}
          class="pc-fan-line"
        />
      );
    })}

    <!-- fan-out chevrons -->
    {outputs.map((_, i) => {
      const oy = outStartY + i * outGap;
      return (
        <path
          d={`M${outX - 24} ${oy - 5} l6 5 l-6 5`}
          class="pc-chevron"
        />
      );
    })}

    <!-- output nodes -->
    {outputs.map((label, i) => {
      const oy = outStartY + i * outGap;
      const isGallery = i === 4;
      return (
        <g class="pc-output" data-index={i}>
          <rect
            x={outX - 16} y={oy - 14} width="172" height="28" rx="6"
            class={`pc-output-bg ${isGallery ? 'pc-output-bg--accent' : ''}`}
          />
          <text
            class={`pc-output-label ${isGallery ? 'pc-output-label--accent' : ''}`}
            x={outX + 70} y={oy + 4}
            text-anchor="middle"
          >
            {label}
          </text>
        </g>
      );
    })}

    <!-- codegen hub highlight on step 3 -->
    <circle cx={stationXs[2]} cy={stationY} r="12" class="pc-hub-ring" />

  </svg>
  <figcaption class="prelude-codegen__caption">{t('case.prelude.codegen.caption')}</figcaption>
</figure>

<script>
  import { gsap } from 'gsap';

  const diagram = document.querySelector('.prelude-codegen');
  if (diagram) {
    const stations = diagram.querySelectorAll('.pc-station, .pc-station--active');
    const chevrons = diagram.querySelectorAll('.pc-chevron');
    const fanLines = diagram.querySelectorAll('.pc-fan-line');
    const outputs = diagram.querySelectorAll('.pc-output');
    const hubRing = diagram.querySelector('.pc-hub-ring');

    stations.forEach((station, i) => {
      gsap.from(station, {
        scale: 0,
        opacity: 0,
        duration: 0.5,
        delay: 0.2 + i * 0.15,
        ease: 'back.out(2)',
        transformOrigin: '50% 50%',
      });
    });

    chevrons.forEach((chev, i) => {
      gsap.from(chev, {
        opacity: 0,
        x: -6,
        duration: 0.4,
        delay: 0.5 + i * 0.1,
        ease: 'power2.out',
      });
    });

    fanLines.forEach((line, i) => {
      gsap.from(line, {
        opacity: 0,
        duration: 0.4,
        delay: 0.8 + i * 0.08,
        ease: 'power2.out',
      });
    });

    outputs.forEach((out, i) => {
      gsap.from(out, {
        opacity: 0,
        x: -12,
        duration: 0.5,
        delay: 1.0 + i * 0.1,
        ease: 'power2.out',
      });
    });

    if (hubRing) {
      gsap.to(hubRing, {
        attr: { r: 14 },
        duration: 1.6,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
        delay: 1.5,
      });
    }
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .prelude-codegen {
    margin: $space-12 0;
    padding: $space-4 0;
  }

  .prelude-codegen__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .prelude-codegen__caption {
    text-align: center;
    font-size: $text-sm;
    color: var(--color-text-tertiary);
    margin-top: $space-6;
    line-height: $line-normal;
  }

  .pc-rail {
    stroke: currentColor;
    stroke-opacity: 0.22;
    stroke-width: 2;
    stroke-dasharray: 6 4;
    stroke-linecap: round;
    animation: pc-flow 1.2s linear infinite;
  }

  @keyframes pc-flow {
    to {
      stroke-dashoffset: -10;
    }
  }

  .pc-chevron {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.35;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pc-station {
    fill: var(--color-bg-primary);
    stroke: currentColor;
    stroke-opacity: 0.45;
    stroke-width: 1.8;
  }

  .pc-station--active {
    fill: var(--color-link);
    stroke: none;
  }

  .pc-station-dot {
    fill: currentColor;
    fill-opacity: 0.45;
  }

  .pc-title {
    fill: currentColor;
    font-size: 17px;
    font-weight: 600;
  }

  .pc-sub {
    fill: currentColor;
    font-size: 12px;
    opacity: 0.55;
    letter-spacing: -0.01em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .pc-fan-line {
    stroke: currentColor;
    stroke-opacity: 0.18;
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }

  .pc-hub-ring {
    fill: none;
    stroke: var(--color-link);
    stroke-opacity: 0.25;
    stroke-width: 1.4;
  }

  .pc-output-bg {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.32;
    stroke-width: 1.4;
  }

  .pc-output-bg--accent {
    fill: var(--color-link);
    fill-opacity: 0.07;
    stroke: var(--color-link);
    stroke-opacity: 0.8;
    stroke-width: 1.5;
  }

  .pc-output-label {
    fill: currentColor;
    font-size: 13px;
    font-weight: 500;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .pc-output-label--accent {
    fill: var(--color-link);
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 600;
  }
</style>
