---
import Layout from '@/layouts/Layout.astro';
import TopBar from '@/components/TopBar.astro';
import MobileMenu from '@/components/MobileMenu.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Aside from '@/components/Aside.astro';
import Footer from '@/components/Footer.astro';
import { useTranslations } from '@/i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`MDDS Case Study - Andrea Robles Dávila`} description={t('case.mdds.subtitle')} lang={lang}>
  <TopBar lang={lang} />
  <MobileMenu lang={lang} currentPath="/mdds" />

  <main class="page-case">
    <div class="case-layout">
      <Aside contentSelector=".case-content">
        <Breadcrumb label="MDDS" lang={lang} tag="span" />
      </Aside>
      <div class="case-content">
      <section class="case-hero">
        <div class="case-hero__image">
          <img
            src="/assets/mdds-pf.webp"
            alt={t('case.mdds.image_alt')}
            width="1280"
            height="582"
            loading="eager"
          />
        </div>
        <h1 class="case-hero__title">{t('case.mdds.title')}</h1>
        <p class="case-hero__subtitle">{t('case.mdds.subtitle')}</p>
        <div class="case-hero__badges">
          <span class="case-badge">{t('case.mdds.role')}</span>
          <span class="case-badge">{t('case.mdds.company')}</span>
          <span class="case-badge">{t('case.mdds.date')}</span>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.overview.title')}</h2>
        <p class="case-section__text">{t('case.mdds.overview.p1')}</p>
        <p class="case-section__text">{t('case.mdds.overview.p2')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.s1.title')}</h2>
        <p class="case-section__intro">{t('case.mdds.s1.intro')}</p>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.mdds.s1.p1.title')}</h3>
          <p class="case-subsection__text">{t('case.mdds.s1.p1.body')}</p>
        </div>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.mdds.s1.p3.title')}</h3>
          <p class="case-subsection__text">{t('case.mdds.s1.p3.body')}</p>
        </div>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.mdds.s1.p4.title')}</h3>
          <p class="case-subsection__text">{t('case.mdds.s1.p4.body')}</p>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.s2.title')}</h2>
        <p class="case-section__text">{t('case.mdds.s2.p1')}</p>
        <p class="case-section__text">{t('case.mdds.s2.p2')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.s2b.title')}</h2>
        <p class="case-section__text">{t('case.mdds.s2b.p1')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.s2c.title')}</h2>
        <p class="case-section__text">{t('case.mdds.s2c.p1')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.s3.title')}</h2>
        <p class="case-section__text">{t('case.mdds.s3.p1')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.s4.title')}</h2>
        <div class="case-stats">
          <div class="case-stat">
            <p class="case-stat__value">{t('case.mdds.stat1.value')}</p>
            <p class="case-stat__label">{t('case.mdds.stat1.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.mdds.stat2.value')}</p>
            <p class="case-stat__label">{t('case.mdds.stat2.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.mdds.stat3.value')}</p>
            <p class="case-stat__label">{t('case.mdds.stat3.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.mdds.stat4.value')}</p>
            <p class="case-stat__label">{t('case.mdds.stat4.label')}</p>
          </div>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.mdds.s5.title')}</h2>
        <p class="case-section__text">{t('case.mdds.s5.p1')}</p>
      </section>
      <Footer lang={lang} />
      </div>
    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';

  const content = document.querySelector('.case-content');
  if (content) {
    gsap.from(content, {
      opacity: 0,
      y: 24,
      duration: 0.8,
      delay: 0.1,
      ease: 'power2.out',
    });
  }
</script>
