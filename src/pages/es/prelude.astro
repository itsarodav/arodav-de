---
import Layout from '@/layouts/Layout.astro';
import TopBar from '@/components/TopBar.astro';
import MobileMenu from '@/components/MobileMenu.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BackButton from '@/components/BackButton.astro';
import Aside from '@/components/Aside.astro';
import Footer from '@/components/Footer.astro';
import PreludePipeline from '@/components/PreludePipeline.astro';
import PreludeBundle from '@/components/PreludeBundle.astro';
import PreludeSizes from '@/components/PreludeSizes.astro';
import PreludeRoadmap from '@/components/PreludeRoadmap.astro';
import { useTranslations } from '@/i18n';

const lang = 'es';
const t = useTranslations(lang);
---

<Layout title={`Prelude DS Icons Case Study - Andrea Robles Dávila`} description={t('case.prelude.subtitle')} lang={lang}>
  <TopBar lang={lang} />
  <MobileMenu lang={lang} currentPath="/es/prelude" />

  <main class="page-case">
    <Aside contentSelector=".case-content" lang={lang} />
    <div class="case-content">
      <Breadcrumb label="Prelude Icons" lang={lang} tag="span" />
      <BackButton lang={lang} />
      <section class="case-hero">
        <div class="case-hero__image">
          <img
            src="/assets/prelude-ic-pf.webp"
            alt={t('case.prelude.image_alt')}
            width="1280"
            height="582"
            loading="eager"
          />
        </div>
        <h1 class="case-hero__title">{t('case.prelude.title')}</h1>
        <p class="case-hero__subtitle">{t('case.prelude.subtitle')}</p>
        <div class="case-hero__badges">
          <span class="case-badge">{t('case.prelude.role')}</span>
          <span class="case-badge">{t('case.prelude.company')}</span>
          <span class="case-badge">{t('case.prelude.date')}</span>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.prelude.overview.title')}</h2>
        <p class="case-section__text">{t('case.prelude.overview.p1')}</p>
        <p class="case-section__text">{t('case.prelude.overview.p2')}</p>
        <p class="case-section__text">{t('case.prelude.overview.p3')}</p>
        <p class="case-section__text">{t('case.prelude.overview.p4')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.prelude.s1.title')}</h2>
        <p class="case-section__intro">{t('case.prelude.s1.intro')}</p>
        <p class="case-section__text">{t('case.prelude.s1.p1')}</p>
        <p class="case-section__text">{t('case.prelude.s1.p2')}</p>

        <PreludeBundle lang={lang} />

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.prelude.s1.p1.title')}</h3>
          <p class="case-subsection__text">{t('case.prelude.s1.p1.body')}</p>
        </div>

        <PreludePipeline lang={lang} />

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.prelude.s1.p2.title')}</h3>
          <p class="case-subsection__text">{t('case.prelude.s1.p2.body')}</p>
        </div>

        <PreludeSizes lang={lang} />

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.prelude.s1.p3.title')}</h3>
          <p class="case-subsection__text">{t('case.prelude.s1.p3.body')}</p>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.prelude.s2.title')}</h2>
        <p class="case-section__text">{t('case.prelude.s2.p1')}</p>
        <p class="case-section__text">{t('case.prelude.s2.p2')}</p>
        <p class="case-section__text">{t('case.prelude.s2.p3')}</p>
        <p class="case-section__text">{t('case.prelude.s2.p4')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.prelude.s3.title')}</h2>
        <div class="case-stats">
          <div class="case-stat">
            <p class="case-stat__value">{t('case.prelude.stat1.value')}</p>
            <p class="case-stat__label">{t('case.prelude.stat1.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.prelude.stat2.value')}</p>
            <p class="case-stat__label">{t('case.prelude.stat2.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.prelude.stat3.value')}</p>
            <p class="case-stat__label">{t('case.prelude.stat3.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.prelude.stat4.value')}</p>
            <p class="case-stat__label">{t('case.prelude.stat4.label')}</p>
          </div>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.prelude.s4.title')}</h2>
        <p class="case-section__text">{t('case.prelude.s4.p1')}</p>
        <p class="case-section__text">{t('case.prelude.s4.p2')}</p>

        <PreludeRoadmap lang={lang} />

        <p class="case-section__text">{t('case.prelude.s4.p3')}</p>
      </section>
    <Footer lang={lang} />
    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';

  const content = document.querySelector('.case-content');
  if (content) {
    gsap.from(content, {
      opacity: 0,
      y: 24,
      duration: 0.8,
      delay: 0.1,
      ease: 'power2.out',
    });
  }
</script>
