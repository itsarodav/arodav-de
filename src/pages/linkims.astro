---
import Layout from '@/layouts/Layout.astro';
import TopBar from '@/components/TopBar.astro';
import MobileMenu from '@/components/MobileMenu.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BackButton from '@/components/BackButton.astro';
import Aside from '@/components/Aside.astro';
import Footer from '@/components/Footer.astro';
import { useTranslations } from '@/i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`Linkims Case Study - Andrea Robles Dávila`} description={t('case.linkims.subtitle')} lang={lang}>
  <TopBar lang={lang} />
  <MobileMenu lang={lang} currentPath="/linkims" />

  <main class="page-case">
    <Aside contentSelector=".case-content" lang={lang} />
    <div class="case-content">
      <Breadcrumb label="Linkims" lang={lang} tag="span" />
      <BackButton lang={lang} />
      <section class="case-hero">
        <div class="case-hero__image">
          <img
            src="/assets/linkims-pf.webp"
            alt={t('case.linkims.image_alt')}
            width="1280"
            height="582"
            loading="eager"
            style="object-position: center 1%;"
          />
        </div>
        <h1 class="case-hero__title">{t('case.linkims.title')}</h1>
        <p class="case-hero__subtitle">{t('case.linkims.subtitle')}</p>
        <div class="case-hero__badges">
          <span class="case-badge">{t('case.linkims.role')}</span>
          <span class="case-badge">{t('case.linkims.company')}</span>
          <span class="case-badge">{t('case.linkims.date')}</span>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.linkims.overview.title')}</h2>
        <p class="case-section__text">{t('case.linkims.overview.p1')}</p>
        <p class="case-section__text">{t('case.linkims.overview.p2')}</p>
        <p class="case-section__text">{t('case.linkims.overview.p3')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.linkims.s1.title')}</h2>
        <p class="case-section__intro">{t('case.linkims.s1.intro')}</p>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.linkims.s1.p1.title')}</h3>
          <p class="case-subsection__text">{t('case.linkims.s1.p1.body')}</p>
        </div>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.linkims.s1.p2.title')}</h3>
          <p class="case-subsection__text">{t('case.linkims.s1.p2.body')}</p>
        </div>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.linkims.s1.p3.title')}</h3>
          <p class="case-subsection__text">{t('case.linkims.s1.p3.body')}</p>
        </div>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.linkims.s1.p4.title')}</h3>
          <p class="case-subsection__text">{t('case.linkims.s1.p4.body')}</p>
        </div>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.linkims.s1.p5.title')}</h3>
          <p class="case-subsection__text">{t('case.linkims.s1.p5.body')}</p>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.linkims.s2.title')}</h2>
        <p class="case-section__intro">{t('case.linkims.s2.intro')}</p>
        <ul class="case-detail-list">
          <li class="case-detail-list__item">{t('case.linkims.s2.p1')}</li>
          <li class="case-detail-list__item">{t('case.linkims.s2.p2')}</li>
          <li class="case-detail-list__item">{t('case.linkims.s2.p3')}</li>
          <li class="case-detail-list__item">{t('case.linkims.s2.p4')}</li>
          <li class="case-detail-list__item">{t('case.linkims.s2.p5')}</li>
        </ul>
        <p class="case-section__text">{t('case.linkims.s2.outro')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.linkims.s3.title')}</h2>
        <div class="case-stats">
          <div class="case-stat">
            <p class="case-stat__value">{t('case.linkims.stat1.value')}</p>
            <p class="case-stat__label">{t('case.linkims.stat1.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.linkims.stat2.value')}</p>
            <p class="case-stat__label">{t('case.linkims.stat2.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.linkims.stat3.value')}</p>
            <p class="case-stat__label">{t('case.linkims.stat3.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.linkims.stat4.value')}</p>
            <p class="case-stat__label">{t('case.linkims.stat4.label')}</p>
          </div>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.linkims.s4.title')}</h2>
        <p class="case-section__text">{t('case.linkims.s4.p1')}</p>
        <p class="case-section__text">{t('case.linkims.s4.p2')}</p>
        <p class="case-section__text">{t('case.linkims.s4.p3')}</p>
      </section>
    <Footer lang={lang} />
    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';

  const content = document.querySelector('.case-content');
  if (content) {
    gsap.from(content, {
      opacity: 0,
      y: 24,
      duration: 0.8,
      delay: 0.1,
      ease: 'power2.out',
    });
  }
</script>
