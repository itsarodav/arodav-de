---
import Layout from '@/layouts/Layout.astro';
import TopBar from '@/components/TopBar.astro';
import MobileMenu from '@/components/MobileMenu.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BackButton from '@/components/BackButton.astro';
import Aside from '@/components/Aside.astro';
import Footer from '@/components/Footer.astro';
import BadgeTicker from '@/components/BadgeTicker.astro';
import FiveToOneDiagram from '@/components/FiveToOneDiagram.astro';
import ManagerHierarchy from '@/components/ManagerHierarchy.astro';
import { useTranslations } from '@/i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`Riffims Case Study - Andrea Robles Dávila`} description={t('case.riffims.subtitle')} lang={lang}>
  <TopBar lang={lang} />
  <MobileMenu lang={lang} currentPath="/riffims" />

  <main class="page-case">
    <Aside contentSelector=".case-content" lang={lang} />
    <div class="case-content">
      <Breadcrumb label="Riffims" lang={lang} tag="span" />
      <BackButton lang={lang} />
      <section class="case-hero">
        <div class="case-hero__image">
          <img
            src="/assets/riffims-pf.webp"
            alt={t('case.riffims.image_alt')}
            width="1280"
            height="582"
            loading="eager"
          />
        </div>
        <h1 class="case-hero__title">{t('case.riffims.title')}</h1>
        <p class="case-hero__subtitle">{t('case.riffims.subtitle')}</p>
        <div class="case-hero__badges">
          <span class="case-badge">{t('case.riffims.role')}</span>
          <span class="case-badge">{t('case.riffims.company')}</span>
          <span class="case-badge">{t('case.riffims.date')}</span>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.overview.title')}</h2>
        <p class="case-section__text">{t('case.riffims.overview.p1')}</p>
        <p class="case-section__text">{t('case.riffims.overview.p2')}</p>
        <p class="case-section__text">{t('case.riffims.overview.p3')}</p>
        <p class="case-section__text">{t('case.riffims.overview.p4')}</p>
        <FiveToOneDiagram lang="en" />
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.s1.title')}</h2>
        <p class="case-section__intro">{t('case.riffims.s1.intro')}</p>
        <p class="case-section__text">{t('case.riffims.s1.intro2')}</p>
        <figure class="case-figure">
          <img
            src="/assets/riffims-login-home.webp"
            alt={t('case.riffims.img1.alt')}
            width="1280"
            height="852"
            loading="eager"
          />
          <figcaption>{t('case.riffims.img1.caption')}</figcaption>
        </figure>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.riffims.s1.p1.title')}</h3>
          <p class="case-subsection__text">{t('case.riffims.s1.p1.body')}</p>
        </div>

        <BadgeTicker caption={t('case.riffims.badges.caption')} />

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.riffims.s1.p2.title')}</h3>
          <p class="case-subsection__text">{t('case.riffims.s1.p2.body')}</p>
        </div>

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.riffims.s1.p3.title')}</h3>
          <p class="case-subsection__text">{t('case.riffims.s1.p3.body')}</p>
        </div>

        <ManagerHierarchy lang="en" />

        <div class="case-subsection">
          <h3 class="case-subsection__title">{t('case.riffims.s1.p4.title')}</h3>
          <p class="case-subsection__text">{t('case.riffims.s1.p4.body')}</p>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.s2.title')}</h2>
        <p class="case-section__text">{t('case.riffims.s2.p1')}</p>
        <p class="case-section__text">{t('case.riffims.s2.p2')}</p>
        <p class="case-section__text">{t('case.riffims.s2.p3')}</p>
        <p class="case-section__text">{t('case.riffims.s2.p4')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.s3.title')}</h2>
        <p class="case-section__text">{t('case.riffims.s3.p1')}</p>
        <p class="case-section__text">{t('case.riffims.s3.p2')}</p>
        <p class="case-section__text">{t('case.riffims.s3.p3')}</p>
        <p class="case-section__text">{t('case.riffims.s3.p4')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.s4.title')}</h2>
        <p class="case-section__text">{t('case.riffims.s4.p1')}</p>
        <p class="case-section__text">{t('case.riffims.s4.p2')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.s5.title')}</h2>
        <p class="case-section__text">{t('case.riffims.s5.p1')}</p>
        <figure class="case-figure">
          <img
            src="/assets/riffims-cp-riffi.webp"
            alt={t('case.riffims.img2.alt')}
            width="1280"
            height="852"
            loading="lazy"
          />
          <figcaption>{t('case.riffims.img2.caption')}</figcaption>
        </figure>
        <p class="case-section__text">{t('case.riffims.s5.p2')}</p>
        <p class="case-section__text">{t('case.riffims.s5.p3')}</p>
        <p class="case-section__text">{t('case.riffims.s5.p4')}</p>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.s6.title')}</h2>
        <div class="case-stats">
          <div class="case-stat">
            <p class="case-stat__value">{t('case.riffims.stat1.value')}</p>
            <p class="case-stat__label">{t('case.riffims.stat1.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.riffims.stat2.value')}</p>
            <p class="case-stat__label">{t('case.riffims.stat2.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.riffims.stat3.value')}</p>
            <p class="case-stat__label">{t('case.riffims.stat3.label')}</p>
          </div>
          <div class="case-stat">
            <p class="case-stat__value">{t('case.riffims.stat4.value')}</p>
            <p class="case-stat__label">{t('case.riffims.stat4.label')}</p>
          </div>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section__title">{t('case.riffims.s7.title')}</h2>
        <p class="case-section__text">{t('case.riffims.s7.p1')}</p>
        <p class="case-section__text">{t('case.riffims.s7.p2')}</p>
        <p class="case-section__text">{t('case.riffims.s7.p3')}</p>
      </section>
    <Footer lang={lang} />
    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';

  const content = document.querySelector('.case-content');
  if (content) {
    gsap.from(content, {
      opacity: 0,
      y: 24,
      duration: 0.8,
      delay: 0.1,
      ease: 'power2.out',
    });
  }
</script>
